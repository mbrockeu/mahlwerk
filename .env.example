# Where the SQLite database lives (created on first start).
MAHLWERK_DB=./data/mahlwerk.db

# Open Food Facts asks every client to identify itself. Put a contact address here.
MAHLWERK_CONTACT=you@example.org

# Who is calling. "single" (default): no login, everyone is one local user. Fine for a private network
# or behind a proxy that does its own access control.
# "proxy": a reverse proxy has authenticated the user and passes the name in a header. The header is
# trusted only when the TCP peer is listed in MAHLWERK_TRUSTED_PROXIES; everyone else gets 401.
#MAHLWERK_AUTH=single
#MAHLWERK_SINGLE_USER=me
#MAHLWERK_AUTH=proxy
# "local": the app has its own accounts with passwords; the first visit creates the first admin. Use HTTPS in
# front of it; behind a TLS proxy also set MAHLWERK_COOKIE_SECURE=1 and list the proxy in MAHLWERK_TRUSTED_PROXIES.
#MAHLWERK_AUTH=local
# "oidc": sign in through an OpenID Connect provider (code flow with PKCE). Needs the three settings below; the redirect
# URI to register at the provider is <MAHLWERK_PUBLIC_URL>/api/v1/auth/oidc/callback. Use HTTPS. See README, Authentication.
#MAHLWERK_AUTH=oidc
#MAHLWERK_OIDC_ISSUER=https://id.example.org
#MAHLWERK_OIDC_CLIENT_ID=mahlwerk
#MAHLWERK_PUBLIC_URL=https://mahlwerk.example.org
#MAHLWERK_OIDC_CLIENT_SECRET=
#MAHLWERK_OIDC_BUTTON_LABEL=Example ID
# Admin = member of this group (also used in proxy mode). Claim names and scopes, if your provider differs:
#MAHLWERK_ADMIN_GROUP=admin
#MAHLWERK_OIDC_GROUPS_CLAIM=groups
#MAHLWERK_OIDC_USERNAME_CLAIM=preferred_username
# Take over existing users of the same name on the first sign-in (moving from proxy/single). Only if the provider owns the names.
#MAHLWERK_OIDC_LINK_EXISTING=1
# Sessions in oidc mode: 7 days sliding, 30 at most by default (local: 30 and 180).
#MAHLWERK_SESSION_DAYS=7
#MAHLWERK_SESSION_MAX_DAYS=30
# oidc mode: the host check is on by default (host of MAHLWERK_PUBLIC_URL plus loopback). Own CA of the provider: SSL_CERT_FILE=/path/ca.pem
#MAHLWERK_COOKIE_SECURE=1
#MAHLWERK_TRUSTED_PROXIES=127.0.0.1
#MAHLWERK_PROXY_USER_HEADER=Remote-User
#MAHLWERK_PROXY_NAME_HEADER=Remote-Name

# Built frontend to serve (default: web/dist in the repository; nothing is served if it does not exist)
#MAHLWERK_WEB_DIR=./web/dist

# Local product catalogue for searching packaged products by name (filled with
# `python -m mahlwerk.catalog import-off`). Default: catalog.db next to the main database.
#MAHLWERK_CATALOG_DB=./data/catalog.db
# Basic foods from the BLS (`python -m mahlwerk.catalog import-bls FILE.xlsx`). Default: catalog-bls.db next to the file above.
#MAHLWERK_CATALOG_BLS_DB=./data/catalog-bls.db

# Optional overrides
#MAHLWERK_OFF_BASE=https://world.openfoodfacts.org
#MAHLWERK_CACHE_DAYS=30

# Host names the server answers to (comma separated, no port, "*" = any); other Host headers get 421. Protects against
# DNS rebinding. Default: single mode only localhost,127.0.0.1,[::1]; proxy and local: no check, so set it there.
#MAHLWERK_ALLOWED_HOSTS=localhost,mahlwerk.example.org
# local mode, database that already has users: code for the setup page (otherwise a random one is logged once).
#MAHLWERK_SETUP_TOKEN=
# local mode: keep /docs, /redoc and /openapi.json.
#MAHLWERK_DOCS=1

# Let users fill their own profile with invented demo data (and remove it again). Off by default.
#MAHLWERK_DEMO_DATA=1

# The built-in demo account: an admin can switch to an invented user with 90 days of sample data and back, so the own account
# stays free of test data. Off by default; set it (on/off) to fix the switch, otherwise the admin decides in the admin area.
# The account is the user row "~demo" (no sign-in mode can produce that name); a real user called "demo" is unaffected.
#MAHLWERK_DEMO_ACCOUNT=on

# Keep the last 20 uploaded label photos and their OCR text, to improve the label reader.
# Off unless set.
#MAHLWERK_LABEL_DEBUG_DIR=./data/label-debug

# Admin area: in proxy mode the proxy sends the groups of the user; members of the admin group are admins.
# (In single mode the one user is an admin.)
#MAHLWERK_PROXY_GROUPS_HEADER=Remote-Groups
#MAHLWERK_ADMIN_GROUP=admin

# Integrations. Each can also be switched in the admin area; a variable set here wins over it.
#MAHLWERK_TOKENS=off
#MAHLWERK_WEBHOOKS=off
# Recipes from web pages (off by default; the server then fetches addresses that people paste). Before switching it on, list YOUR OWN
# domains: through a router a public name can lead back into the home network. An entry blocks the name and its subdomains; the host of
# MAHLWERK_PUBLIC_URL and the names in MAHLWERK_ALLOWED_HOSTS are blocked automatically.
#MAHLWERK_WEB_RECIPES=on
#MAHLWERK_WEB_RECIPES_BLOCKED_HOSTS=example.org,home.example.net
# Store the picture a recipe page names (fetched once, kept small on this server; off by default). The pictures belong to the sites.
#MAHLWERK_WEB_RECIPES_IMAGES=on
# Empty: any public host. Listed hosts are the only allowed ones and may be internal (Home Assistant in the LAN).
#MAHLWERK_WEBHOOK_HOSTS=homeassistant.local,flow.example.org
#MAHLWERK_OFF_LOOKUP=off
#MAHLWERK_OFF_COUNTRIES=en:germany,en:austria

# Cookidoo connector (optional, unofficial interface). Needs `pip install "mahlwerk[cookidoo]"` (Docker: build argument
# WITH_COOKIDOO=1), then switch it on in the admin area (or set MAHLWERK_COOKIDOO=on). ONE Cookidoo account for the whole
# installation: every user sees the meal plan and collections of that account. The credentials stay in the environment;
# they are never written to the database, the logs or an answer. Keep this file private.
#MAHLWERK_COOKIDOO=on
#MAHLWERK_COOKIDOO_EMAIL=
#MAHLWERK_COOKIDOO_PASSWORD=
#MAHLWERK_COOKIDOO_COUNTRY=de
#MAHLWERK_COOKIDOO_LANGUAGE=de-DE

# Credentials that people or admins store in the app (Cookidoo accounts) are kept encrypted in the database. The key is
# this value (at least 32 characters, e.g. `openssl rand -base64 32`), otherwise a key file <database>.key next to the
# database, made on first use. Back the key up; without it stored credentials count as "not set" and are entered again.
#MAHLWERK_SECRET_KEY=

# Cookidoo: the shared household account can be set in the admin area; these variables win over it. Own accounts per
# person can be forbidden with MAHLWERK_COOKIDOO_PERSONAL=off.
#MAHLWERK_COOKIDOO=on
#MAHLWERK_COOKIDOO_EMAIL=
#MAHLWERK_COOKIDOO_PASSWORD=
#MAHLWERK_COOKIDOO_COUNTRY=de
#MAHLWERK_COOKIDOO_LANGUAGE=de-DE
#MAHLWERK_COOKIDOO_PERSONAL=on
# Store the pictures of Cookidoo recipes (fetched once per recipe, kept small on this server; off by default). They belong to Cookidoo.
#MAHLWERK_COOKIDOO_IMAGES=on

# Recipe pictures (own photos and, if switched on, the providers') live in the folder `<database file name>.images` next to the database: back it up
# with the database. Upper limit for the folder in MB (a picture that would not fit is refused with a clear message).
#MAHLWERK_IMAGES_MAX_MB=1024

# Direct one-time Yazio sign-in (unofficial interface, off by default, own responsibility; see README, Importing from
# Yazio). Needs the identifiers of the Yazio app; they are not part of Mahlwerk.
#MAHLWERK_YAZIO_LOGIN=on
#MAHLWERK_YAZIO_CLIENT_ID=
#MAHLWERK_YAZIO_CLIENT_SECRET=
