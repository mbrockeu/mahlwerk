{
  "name": "mahlwerk-ts",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Mahlwerk backend in TypeScript: core (no node imports, shared with a later app) and the Node server.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/main.ts",
    "testhost": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/testhost.ts",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
